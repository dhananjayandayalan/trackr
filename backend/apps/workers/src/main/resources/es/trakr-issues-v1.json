{
  "settings": {
    "number_of_shards": 1,
    "number_of_replicas": 0,
    "refresh_interval": "1s",
    "analysis": {
      "filter": {
        "trakr_possessive": { "type": "stemmer", "language": "possessive_english" },
        "trakr_light_stemmer": { "type": "stemmer", "language": "light_english" },
        "trakr_synonyms": { "type": "synonym_graph", "synonyms": [] },
        "trakr_key_prefix": { "type": "edge_ngram", "min_gram": 1, "max_gram": 20 }
      },
      "normalizer": {
        "trakr_lowercase": { "type": "custom", "filter": ["lowercase", "asciifolding"] }
      },
      "analyzer": {
        "trakr_text": {
          "type": "custom",
          "tokenizer": "standard",
          "filter": ["lowercase", "asciifolding", "trakr_possessive", "trakr_light_stemmer"]
        },
        "trakr_text_search": {
          "type": "custom",
          "tokenizer": "standard",
          "filter": ["lowercase", "asciifolding", "trakr_possessive", "trakr_light_stemmer", "trakr_synonyms"]
        },
        "trakr_key_prefix": {
          "type": "custom",
          "tokenizer": "keyword",
          "filter": ["lowercase", "trakr_key_prefix"]
        },
        "trakr_key_search": {
          "type": "custom",
          "tokenizer": "keyword",
          "filter": ["lowercase"]
        }
      }
    }
  },
  "mappings": {
    "dynamic": "strict",
    "properties": {
      "id": { "type": "keyword" },
      "workspaceId": { "type": "keyword" },
      "projectId": { "type": "keyword" },
      "projectKey": { "type": "keyword" },
      "key": {
        "type": "keyword",
        "fields": {
          "prefix": { "type": "text", "analyzer": "trakr_key_prefix", "search_analyzer": "trakr_key_search" }
        }
      },
      "number": { "type": "long" },
      "type": { "type": "keyword" },
      "priority": { "type": "keyword" },
      "priorityRank": { "type": "byte" },
      "statusCategory": { "type": "keyword" },
      "statusId": { "type": "keyword" },
      "statusName": {
        "type": "keyword",
        "fields": { "text": { "type": "text", "analyzer": "trakr_text" } }
      },
      "summary": {
        "type": "text",
        "analyzer": "trakr_text",
        "search_analyzer": "trakr_text_search",
        "fields": {
          "raw": { "type": "keyword", "normalizer": "trakr_lowercase" },
          "suggest": { "type": "search_as_you_type" }
        }
      },
      "descriptionText": { "type": "text", "analyzer": "trakr_text", "search_analyzer": "trakr_text_search" },
      "commentsText": { "type": "text", "analyzer": "trakr_text", "search_analyzer": "trakr_text_search" },
      "labels": { "type": "keyword" },
      "assigneeId": { "type": "keyword" },
      "reporterId": { "type": "keyword" },
      "assigneeName": {
        "type": "keyword",
        "fields": { "text": { "type": "text", "analyzer": "trakr_text" } }
      },
      "parentId": { "type": "keyword" },
      "epicId": { "type": "keyword" },
      "epicName": { "type": "keyword" },
      "sprintId": { "type": "keyword" },
      "sprintName": { "type": "keyword" },
      "sprintState": { "type": "keyword" },
      "storyPoints": { "type": "scaled_float", "scaling_factor": 10 },
      "flagged": { "type": "boolean" },
      "watcherIds": { "type": "keyword" },
      "mentionedUserIds": { "type": "keyword" },
      "createdAt": { "type": "date" },
      "updatedAt": { "type": "date" },
      "resolvedAt": { "type": "date" },
      "dueDate": { "type": "date" },
      "startDate": { "type": "date" },
      "rank": { "type": "keyword" },
      "deleted": { "type": "boolean" }
    }
  }
}
